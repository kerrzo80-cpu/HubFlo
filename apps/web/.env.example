# Local web app environment.
# Copy to apps/web/.env.local for local testing. Do not commit real keys.

OPENAI_API_KEY=
NEXA_TAKEOFF_OPENAI_MODEL=gpt-5.5
NEXA_ASSISTANT_OPENAI_MODEL=gpt-5.6-sol

# Optional local backup folder (defaults to <store dir>/backups)
NEXA_BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
