{
  "name": "hubflo",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "pnpm --filter @hubflo/web dev",
    "dev:local": "./scripts/pnpm.sh --filter @hubflo/web dev",
    "build": "pnpm --filter @hubflo/web build",
    "build:local": "./scripts/pnpm.sh --filter @hubflo/web build",
    "typecheck": "scripts/typecheck.sh",
    "typecheck:all": "scripts/typecheck.sh",
    "typecheck:raw": "pnpm -r typecheck",
    "test:local": "./scripts/pnpm.sh -r test",
    "test": "pnpm -r test",
    "smoke:live": "node scripts/deploy-smoke.mjs --base https://nexa-live.onrender.com --hold-seconds 120",
    "smoke:live:once": "node scripts/deploy-smoke.mjs --base https://nexa-live.onrender.com",
    "e2e:test-jobs": "node scripts/e2e-test-jobs.mjs",
    "e2e:test-jobs:live": "NEXA_E2E_BASE_URL=https://nexa-live.onrender.com node scripts/e2e-test-jobs.mjs",
    "ops:drill": "node scripts/ops-harden-drill.mjs",
    "ops:drill:live": "NEXA_E2E_BASE_URL=https://nexa-live.onrender.com node scripts/ops-harden-drill.mjs",
    "ops:inventory": "node scripts/nexa-production-inventory.mjs",
    "test:domain": "pnpm --filter @hubflo/domain test",
    "db:generate:local": "./scripts/pnpm.sh --filter @hubflo/database db:generate",
    "db:generate": "pnpm --filter @hubflo/database db:generate",
    "db:migrate:local": "./scripts/pnpm.sh --filter @hubflo/database db:migrate",
    "db:migrate": "pnpm --filter @hubflo/database db:migrate"
  }
}
