DATABASE_URL=postgresql://hubflo:hubflo@localhost:5432/hubflo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted pilot persistence. Leave blank locally to use .hubflo-runtime JSON files.
NEXA_STORE_PATH=
NEXA_STORE_DIR=

# Workspace mode: demo (seed data) or live (blank store on first boot)
NEXA_WORKSPACE_MODE=demo

# Authentication
# - Omit NEXA_AUTH_MODE locally for open dev + client employee login shell
# - NEXA_AUTH_MODE=users enables /login and server-verified sessions (production)
NEXA_AUTH_MODE=
NEXA_ADMIN_NAME=
NEXA_ADMIN_USERNAME=
NEXA_ADMIN_EMPLOYEE_ID=
NEXA_ADMIN_PASSWORD=

# Pilot gate (Render pilot only — not used when NEXA_AUTH_MODE=users)
NEXA_PILOT_USER=nexa
NEXA_PILOT_PIN=

# Optional: real OpenAI-powered NeXa Takeoff extraction and Buddy chat.
# Render nexa-live already uses NEXA_OPENAI_API_KEY — both names are accepted.
OPENAI_API_KEY=
NEXA_OPENAI_API_KEY=
NEXA_TAKEOFF_OPENAI_MODEL=gpt-5.5
NEXA_ASSISTANT_OPENAI_MODEL=

# --- simPRO integration (server-side only — never expose in frontend) ---

# Preferred: direct simPRO Premium OAuth refresh flow
# Base URL is your simPRO account host, e.g. https://errolwatson.simprosuite.com
SIMPRO_BASE_URL=
SIMPRO_API_BASE_URL=
SIMPRO_COMPANY_ID=
SIMPRO_CLIENT_ID=
SIMPRO_CLIENT_SECRET=
SIMPRO_REFRESH_TOKEN=
SIMPRO_REFRESH_TOKEN_FILE=
SIMPRO_OAUTH_TOKEN_URL=
SIMPRO_WEBHOOK_SECRET=

# Optional defaults when pushing quotes/jobs without mapped customer/site IDs
SIMPRO_DEFAULT_CUSTOMER_ID=
SIMPRO_DEFAULT_SITE_ID=

# Legacy static token (fallback only — prefer OAuth refresh above)
SIMPRO_ACCESS_TOKEN=

# Optional: webhook push into a custom bridge
SIMPRO_QUOTE_PUSH_URL=
SIMPRO_QUOTE_PUSH_TOKEN=
SIMPRO_JOB_PUSH_URL=

# Optional: use the historical scheduler app as the simPRO owner for quote/job push.
# Keeps simPRO credentials in the scheduler app; NeXa posts payloads to it.
SIMPRO_SCHEDULER_BASE_URL=https://ewg-hub-scheduler.onrender.com
SIMPRO_SCHEDULER_QUOTE_PUSH_URL=
SIMPRO_SCHEDULER_JOB_PUSH_URL=
SIMPRO_SCHEDULER_HUB_PASSWORD=

# WhatsApp Business / Cloud API pilot values
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
