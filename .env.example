DATABASE_URL=postgresql://hubflo:hubflo@localhost:5432/hubflo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted pilot persistence. Leave blank locally to use .hubflo-runtime JSON files.
NEXA_STORE_PATH=
NEXA_STORE_DIR=

# Workspace mode: demo (seed data) or live/trial (blank store on first boot)
NEXA_WORKSPACE_MODE=demo

# Friend-trial only (nexa-trial). Never set on nexa-live or nexa-pilot.
NEXA_TRIAL=
NEXA_COMPANY_NAME=
# Optional trial clock (nexa-trial only). Start is stored on disk at first boot.
NEXA_TRIAL_DAYS=
NEXA_TRIAL_EXPIRES_AT=
NEXA_TRIAL_STARTED_AT=
NEXA_TRIAL_LICENCE_PATH=

# Authentication
# - Omit NEXA_AUTH_MODE locally for open dev + client employee login shell
# - NEXA_AUTH_MODE=users enables /login and server-verified sessions (production)
NEXA_AUTH_MODE=
NEXA_ADMIN_NAME=
NEXA_ADMIN_USERNAME=
NEXA_ADMIN_EMPLOYEE_ID=
NEXA_ADMIN_PASSWORD=

# Pilot gate (Render pilot only — not used when NEXA_AUTH_MODE=users)
NEXA_PILOT_USER=nexa
NEXA_PILOT_PIN=

# Optional: real OpenAI-powered NeXa Takeoff extraction and Buddy chat.
# Render nexa-live already uses NEXA_OPENAI_API_KEY — both names are accepted.
OPENAI_API_KEY=
NEXA_OPENAI_API_KEY=
NEXA_TAKEOFF_OPENAI_MODEL=gpt-5.5
NEXA_ASSISTANT_OPENAI_MODEL=

# --- simPRO integration (server-side only — never expose in frontend) ---

# Preferred: direct simPRO Premium OAuth refresh flow
# Base URL is your simPRO account host, e.g. https://errolwatson.simprosuite.com
SIMPRO_BASE_URL=
SIMPRO_API_BASE_URL=
SIMPRO_COMPANY_ID=
SIMPRO_CLIENT_ID=
SIMPRO_CLIENT_SECRET=
SIMPRO_REFRESH_TOKEN=
SIMPRO_REFRESH_TOKEN_FILE=

# Optional override for Phase A discovery fixture output (defaults to NEXA_STORE_DIR/simpro-discovery-fixtures)
# SIMPRO_DISCOVERY_FIXTURE_DIR=/var/data/simpro-discovery-fixtures
SIMPRO_OAUTH_TOKEN_URL=
SIMPRO_WEBHOOK_SECRET=

# Optional defaults when pushing quotes/jobs without mapped customer/site IDs
SIMPRO_DEFAULT_CUSTOMER_ID=
SIMPRO_DEFAULT_SITE_ID=
# Quote/job Type for direct create: Project | Service | Prepaid (default Service).
# Multi cost-centre quotes/jobs automatically use Project so each NeXa centre gets a named section
# (Service quotes only support one section and often show every centre as the same setup label).
SIMPRO_DEFAULT_QUOTE_TYPE=Service
SIMPRO_DEFAULT_JOB_TYPE=Service
# Fallback Simpro setup cost centre ID when NeXa centre names do not match
SIMPRO_DEFAULT_COST_CENTER_ID=
# Comma-separated Simpro setup cost centre IDs to use in order for NeXa centres (must be distinct)
SIMPRO_COST_CENTER_IDS=
# Required for NeXa Schedules → simPRO diary write (managers app). Use a valid ScheduleRate ID from simPRO.
SIMPRO_DEFAULT_SCHEDULE_RATE_ID=
# Shared secret for Render EOD cron → POST /api/integrations/simpro/sync/cron (and import/tick).
NEXA_IMPORT_TICK_SECRET=
# Optional staff map when NeXa employees are not imported as simpro-staff-{id}: nexaId:12,Name:34
SIMPRO_STAFF_MAP=

# Legacy static token (fallback only — prefer OAuth refresh above)
SIMPRO_ACCESS_TOKEN=

# Optional: webhook push into a custom bridge
SIMPRO_QUOTE_PUSH_URL=
SIMPRO_QUOTE_PUSH_TOKEN=
SIMPRO_JOB_PUSH_URL=

# Optional: use the historical scheduler app as the simPRO owner for quote/job push.
# Keeps simPRO credentials in the scheduler app; NeXa posts payloads to it.
SIMPRO_SCHEDULER_BASE_URL=https://ewg-hub-scheduler.onrender.com
SIMPRO_SCHEDULER_QUOTE_PUSH_URL=
SIMPRO_SCHEDULER_JOB_PUSH_URL=
SIMPRO_SCHEDULER_HUB_PASSWORD=

# --- Xero accounting (platform NeXa Web App — server-side only) ---
# One HubFlo/NeXa OAuth2 Web App. Offices never open developer.xero.com:
# they click Connect → sign in on login.xero.com → approve NeXa.
# Platform host sets Client ID/Secret once on Render for nexa-pilot and nexa-live.
# List BOTH callbacks once on that same NeXa Xero app:
#   https://nexa-pilot.onrender.com/api/integrations/xero/callback
#   https://nexa-live.onrender.com/api/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional override. Default is {NEXT_PUBLIC_APP_URL}/api/integrations/xero/callback
XERO_REDIRECT_URI=
# Optional overrides (tenant is normally discovered on Connect):
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=
XERO_SCOPES=

# WhatsApp Business / Cloud API (company number; attribute sends to the logged-in employee)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# Meta webhook callback URL: https://<your-host>/api/whatsapp/webhook

# Optional stable secret for encrypting stored SMTP app passwords (company + per-employee mailboxes)
NEXA_EMAIL_SETTINGS_SECRET=

# --- Office backups (jobs, tenders, takeoffs, PDFs / drawings) ---
# Local copies land on the persistent disk. Download from Setup → Overview and keep off this server.
NEXA_BACKUP_DIR=/var/data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_TOTAL_MB=1536
# Shared secret for Render cron → POST /api/office-backup/cron (same value on the web service and the cron job)
NEXA_BACKUP_CRON_SECRET=
# Optional S3-compatible off-site copies. Leave blank until a bucket exists. Never commit real keys.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=eu-west-2
# Optional custom endpoint (Cloudflare R2, MinIO). Leave blank for AWS S3.
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=
